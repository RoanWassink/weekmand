# Kopieer naar .env (lokaal) of /opt/weekmand/config.env (router). Alles is optioneel.

# Toegang
APP_PASSWORD=            # wachtwoord voor de webapp (gebruiker: weekmand); verplicht met LAN_HOST
# LAN_HOST=192.168.1.1   # extra luisteradres op het thuisnetwerk
# LAN_LISTEN=uit         # thuisnetwerk tijdelijk uit (alleen 127.0.0.1), LAN_HOST mag blijven staan; aan = standaard
                         # Docker: daar regelt BIND_IP dit (127.0.0.1 = alleen deze computer)
# API_TOKEN=             # vast token voor MCP/OpenAPI/Home Assistant; anders maakt Weekmand er zelf een
# PUBLIC_URL=https://weekmand.example.nl  # adres in meldingen en voor ChatGPT-Actions

# AI (kan ook in de webapp worden gekoppeld)
# AI_PROVIDER=claude     # claude, openai, mistral, deepseek of local
# AI_API_KEY=
# AI_MODEL=              # leeg = standaard (claude-opus-5-5; goedkoper: claude-haiku-5-5)
# AI_BASE_URL=http://192.168.1.20:11434/v1   # alleen voor local (Ollama e.d.)

# Lidl Plus: alleen nodig als Lidl de app-versie van Weekmand weigert
# LIDL_APP_VERSION=16.45.5

# Meldingen
# TELEGRAM_BOT_TOKEN=    # kan ook in de webapp
# NTFY_URL=https://ntfy.sh/een-lang-geheim-onderwerp
# CUTOFF_WARNING_HOURS=4

# Home Assistant
# MQTT_URL=mqtt://gebruiker:wachtwoord@192.168.1.10:1883

# Geheugen begrenzen (router)
# NODE_OPTIONS=--max-old-space-size=96
