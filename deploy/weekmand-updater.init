#!/bin/sh /etc/rc.common
# Voert updates uit die in de Weekmand-webapp zijn aangevraagd. Dat moet als root (de webapp draait
# als nobody en mag geen nieuwe versie installeren). Kijkt elke tien seconden of er een verzoek ligt;
# het werk zelf staat in /opt/weekmand/update/updater.mjs (bijgewerkt door deploy/activate.sh).
START=96
STOP=9
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /bin/sh -c 'node=/opt/weekmand/runtime/node-v24.22.1-linux-arm64-musl/bin/node; while :; do if [ -f /opt/weekmand/data/update-request ]; then "$node" /opt/weekmand/update/updater.mjs; fi; sleep 10; done'
  procd_set_param respawn 3600 5 5
  # Meldingen van de updater in het systeemlog (logread).
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
